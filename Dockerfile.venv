# conda-free version of Dockerfile — uses python3.11 venv + pip only.
# Useful when conda fails inside Isaac Sim Docker due to corporate SSL/CA issues.

# ==============================
# Stage 1: Builder
# ==============================
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
ENV VENV_DIR=/opt/venv
ENV PATH=$VENV_DIR/bin:$PATH

# Optional HTTP/HTTPS proxy
ARG http_proxy
ARG https_proxy
ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}

# Aliyun mirror
RUN sed -i 's|http://archive.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g' /etc/apt/sources.list

# Build deps (GCC 12 + GLU + Vulkan)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-12 g++-12 cmake build-essential unzip git git-lfs \
    libglu1-mesa-dev vulkan-tools wget software-properties-common ca-certificates \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100 \
    && rm -rf /var/lib/apt/lists/*

# Python 3.11 via deadsnakes PPA
RUN add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-dev && \
    rm -rf /var/lib/apt/lists/*

# Newer libstdc++ for Isaac Sim 5.x
RUN add-apt-repository -y ppa:ubuntu-toolchain-r/test && \
    apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 libvulkan1 vulkan-tools && \
    rm -rf /var/lib/apt/lists/*

# Create venv
RUN python3.11 -m venv $VENV_DIR && \
    pip install --upgrade pip setuptools wheel

# PyTorch (CUDA 12.6)
RUN pip install torch==2.7.0 torchvision==0.22.0 torchaudio==2.7.0 \
    --index-url https://download.pytorch.org/whl/cu126

# Isaac Sim
RUN pip install "isaacsim[all,extscache]==5.1.0" --extra-index-url https://pypi.nvidia.com

RUN mkdir -p /home/code
WORKDIR /home/code

# IsaacLab
RUN git clone https://github.com/isaac-sim/IsaacLab.git && \
    cd IsaacLab && \
    ./isaaclab.sh --install

# CycloneDDS
RUN git clone https://github.com/eclipse-cyclonedds/cyclonedds -b releases/0.10.x /cyclonedds && \
    cd /cyclonedds && mkdir build install && cd build && \
    cmake .. -DCMAKE_INSTALL_PREFIX=../install && \
    cmake --build . --target install

ENV CYCLONEDDS_HOME=/cyclonedds/install

# unitree_sdk2_python
RUN git clone https://github.com/unitreerobotics/unitree_sdk2_python && \
    cd unitree_sdk2_python && pip install -e .

# unitree_sim_isaaclab
RUN git clone https://github.com/unitreerobotics/unitree_sim_isaaclab.git /home/code/unitree_sim_isaaclab && \
    cd /home/code/unitree_sim_isaaclab && git submodule update --init --depth 1 && \
    cd teleimager && pip install -e . && \
    cd ../ && pip install -r requirements.txt


# ==============================
# Stage 2: Runtime
# ==============================
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
ENV VENV_DIR=/opt/venv
ENV PATH=$VENV_DIR/bin:$PATH

# Disable Isaac Sim auto-startup
ENV OMNI_KIT_ALLOW_ROOT=1
ENV OMNI_KIT_DISABLE_STARTUP=1

# Runtime deps — needs python3.11 and newer libstdc++ available at runtime too
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglu1-mesa git-lfs zenity unzip software-properties-common ca-certificates && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    add-apt-repository -y ppa:ubuntu-toolchain-r/test && \
    apt-get update && apt-get install -y --no-install-recommends \
    python3.11 libstdc++6 && \
    rm -rf /var/lib/apt/lists/*

# Copy venv and code
COPY --from=builder /home/code/IsaacLab /home/code/IsaacLab
COPY --from=builder /home/code/unitree_sdk2_python /home/code/unitree_sdk2_python
COPY --from=builder /cyclonedds /cyclonedds
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /home/code/unitree_sim_isaaclab /home/code/unitree_sim_isaaclab

ENV CYCLONEDDS_HOME=/cyclonedds/install

# bashrc init (venv is auto-active via PATH; just export Isaac env vars)
RUN echo 'export PATH=/opt/venv/bin:$PATH' >> ~/.bashrc && \
    echo 'export OMNI_KIT_ALLOW_ROOT=1' >> ~/.bashrc && \
    echo 'export OMNI_KIT_DISABLE_STARTUP=1' >> ~/.bashrc

WORKDIR /home/code

CMD ["/bin/bash"]
